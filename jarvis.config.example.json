{
  "repo": {
    "path": "/absolute/path/to/your/working/repository",
    "remote": "origin",
    "baseBranch": "main"
  },
  "repos": {
    "allow": [],
    "allowOwnerRepos": false,
    "allowSelf": false
  },
  "limits": {
    "maxConcurrentWorkers": 1,
    "checkRetries": 3,
    "checkTimeoutMinutes": 15,
    "ciFixRounds": 2,
    "reviewRounds": 3,
    "taskTimeoutMinutes": 60,
    "maxTurnsPerRun": 60,
    "maxBudgetUsdPerRun": 3,
    "dailyBudgetTokens": 50000000,
    "maxPrCommentsPerDay": 100,
    "maxCommitsPerDay": 100,
    "permissionTimeoutMinutes": 30,
    "stallMinutes": 10,
    "firstProgressUpdateSeconds": 30,
    "progressUpdateMinutes": 1
  },
  "watch": {
    "pollSeconds": 60
  },
  "models": {
    "dispatcher": "sonnet",
    "worker": "sonnet",
    "reviewer": "sonnet"
  },
  "allowlist": {
    "githubReviewers": ["github-login-of-a-reviewer"],
    "autoAllowedCommands": []
  },
  "connectors": {
    "notionRoot": "notion-page-id-optional",
    "googleFolder": "google-drive-folder-id-optional"
  },
  "engine": {
    "port": 4310,
    "claudeBinary": "claude"
  },
  "ui": {
    "enabled": true,
    "defaultImage": "node:22-bookworm",
    "readyTimeoutSeconds": 90,
    "prepareTimeoutSeconds": 600,
    "maxStartAttempts": 3,
    "leaseMinutes": 15,
    "maxScenarios": 8,
    "maxScreenshots": 12,
    "maxImageMb": 5,
    "attachToPr": true,
    "autoApproveComments": true,
    "noSandbox": false,
    "paths": [
      "**/*.tsx",
      "**/*.jsx",
      "**/*.vue",
      "**/*.svelte",
      "**/*.css",
      "**/*.scss",
      "**/*.html"
    ]
  },
  "memory": {
    "softCapChars": 4000,
    "backupsKept": 20
  },
  "telemetry": {
    "enabled": false,
    "otlpEndpoint": "http://127.0.0.1:4318",
    "protocol": "http/protobuf"
  }
}
