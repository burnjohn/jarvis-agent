{
  "name": "jarvis",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.23.0",
  "scripts": {
    "dev": "pnpm --parallel --filter @jarvis/engine --filter @jarvis/web dev",
    "dev:remote": "bash scripts/dev-remote.sh",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "deploy": "bash scripts/deploy.sh",
    "deploy:remote": "ssh root@jarvis-01 /home/jarvis/jarvis/scripts/deploy.sh",
    "redeploy": "bash scripts/redeploy.sh"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0"
  }
}
