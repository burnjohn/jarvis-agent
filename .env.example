# Copy to ~/.jarvis/.env. Never set ANTHROPIC_API_KEY here: Jarvis runs on your Claude subscription
# (log in once with `claude`), and the engine refuses to start if an API key is present.

# GitHub: fine-grained PAT of the Jarvis bot account, scoped to the one working repository
GITHUB_TOKEN=

# Connectors (MCP servers configured by Jarvis)
NOTION_TOKEN=
# Google Docs MCP server (@piotr-agier/google-drive-mcp): OAuth client and refresh token from the one-time
# read-only authorisation on the laptop. Steps and scope warning: docs/architecture/connectors.md.
# A service-account key is only an alternative through a 0600 file (GOOGLE_APPLICATION_CREDENTIALS, a path);
# never set that variable on the server, it would win over the refresh token.
GOOGLE_DRIVE_MCP_REFRESH_TOKEN=
GOOGLE_DRIVE_MCP_CLIENT_ID=
GOOGLE_DRIVE_MCP_CLIENT_SECRET=

# Log level of the application's own JSON lines on stderr (run lifecycle, warnings, errors): error, warn or
# info (default info). Fastify's request log is separate: error here -> it logs errors only, otherwise warnings.
# JARVIS_LOG_LEVEL=info

# Optional liveness ping (healthchecks.io check URL, the token is in it, so keep the value here only).
# Empty: no heartbeat. Pings every 60 s, and <url>/fail when the engine's health is failed.
HEARTBEAT_URL=

# Local Postgres (docker compose)
POSTGRES_PASSWORD=jarvis
DATABASE_URL=postgres://jarvis:jarvis@127.0.0.1:5433/jarvis
DATABASE_URL_TEST=postgres://jarvis:jarvis@127.0.0.1:5433/jarvis_test

# Iteration 2: Slack app in Socket Mode
# SLACK_BOT_TOKEN=xoxb-...
# SLACK_APP_TOKEN=xapp-...
