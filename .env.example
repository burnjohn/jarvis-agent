# Copy to ~/.jarvis/.env. Never set ANTHROPIC_API_KEY here: Jarvis runs on your Claude subscription
# (log in once with `claude`), and the engine refuses to start if an API key is present.

# GitHub: fine-grained PAT of the Jarvis bot account, scoped to the one working repository
GITHUB_TOKEN=

# Connectors (MCP servers configured by Jarvis)
NOTION_TOKEN=
# Google: OAuth client for the Google Docs MCP server (exact variables fixed in the plan)

# Log level of the engine's JSON lines on stderr: error, warn or info (default info)
# JARVIS_LOG_LEVEL=info

# Optional liveness ping (healthchecks.io check URL, the token is in it, so keep the value here only).
# Empty: no heartbeat. Pings every 60 s, and <url>/fail when the engine's health is failed.
HEARTBEAT_URL=

# Local Postgres (docker compose)
POSTGRES_PASSWORD=jarvis
DATABASE_URL=postgres://jarvis:jarvis@127.0.0.1:5433/jarvis
DATABASE_URL_TEST=postgres://jarvis:jarvis@127.0.0.1:5433/jarvis_test

# Iteration 2: Slack app in Socket Mode
# SLACK_BOT_TOKEN=xoxb-...
# SLACK_APP_TOKEN=xapp-...
