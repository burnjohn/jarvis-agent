[Unit]
Description=Jarvis engine
After=network-online.target docker.service
Wants=network-online.target

[Service]
User=jarvis
WorkingDirectory=/home/jarvis/jarvis
Environment=NODE_ENV=production
EnvironmentFile=/etc/jarvis/infisical.env
ExecStart=/home/jarvis/jarvis/scripts/with-secrets.sh pnpm --filter @jarvis/engine start
# Retries back off 1+2+4+8+16+32 s; --retry-max-time stops new retries after 60 s, so the worst case
# (~63 s + one 5 s attempt) ends inside TimeoutStartSec.
ExecStartPost=/usr/bin/curl -fsS --max-time 5 --retry 10 --retry-connrefused --retry-max-time 60 http://127.0.0.1:4310/api/health
TimeoutStartSec=90
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
