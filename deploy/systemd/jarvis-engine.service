[Unit]
Description=Jarvis engine
After=network-online.target docker.service
Wants=network-online.target

[Service]
User=jarvis
WorkingDirectory=/home/jarvis/jarvis
Environment=NODE_ENV=production
# ADR-0014: where the UI check's Chromium lives; harmless when it was never installed.
Environment=PLAYWRIGHT_BROWSERS_PATH=/ms-playwright
EnvironmentFile=/etc/jarvis/infisical.env
ExecStart=/home/jarvis/jarvis/scripts/with-secrets.sh pnpm --filter @jarvis/engine start
# 200 and 503 both count as started: 503 is an honest "alive, database down", not a crash.
ExecStartPost=/home/jarvis/jarvis/scripts/wait-healthy.sh
TimeoutStartSec=90
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
