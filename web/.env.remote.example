# Copy to web/.env.remote (git-ignored) and run `pnpm dev:remote`: the local UI, with hot reload, talking
# to the Jarvis engine on the server. The address is the server's `tailscale serve` URL (tailnet only);
# `tailscale serve status` on the server prints it.
JARVIS_API_URL=https://<host>.<tailnet>.ts.net
