{
  "steps": [
    {
      "type": "init"
    },
    {
      "type": "text",
      "text": "Spec approved, implementing."
    },
    {
      "type": "git_commit",
      "message": "feat: add the About page",
      "files": {
        "about.txt": "About page\n"
      }
    },
    {
      "type": "jarvis_tool",
      "tool": "report_stage",
      "input": {
        "stage": "Reviewing"
      }
    },
    {
      "type": "jarvis_tool",
      "tool": "start_dev_server",
      "input": { "plan": { "app": { "command": "npm run dev -- --host 0.0.0.0", "port": 5173 } } }
    },
    {
      "type": "jarvis_tool",
      "tool": "attach_image",
      "input": {
        "path": "screenshots/001-about-page.png",
        "alt": "the About page"
      }
    },
    {
      "type": "jarvis_tool",
      "tool": "stop_dev_server",
      "input": {}
    },
    {
      "type": "jarvis_tool",
      "tool": "open_pr",
      "input": {
        "title": "Add an About page",
        "body": "## What\nAn About page at /about.\n\n## Sources\nspec.md\n\n## Open questions\nNone."
      }
    },
    {
      "type": "result",
      "text": "draft PR opened"
    }
  ]
}
